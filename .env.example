# Copia este archivo como .env si quieres cambiar algo. El .env NUNCA se sube a GitHub.

# Carpetas donde buscar los CSV / zip de Exportify, separadas por ';'.
# Vacío = Descargas y ./data
DATA_DIR=

# App propia de Spotify (también se puede pegar desde la web): https://developer.spotify.com/dashboard
# Redirect URI: http://127.0.0.1:8766/callback  · requiere que la cuenta dueña de la app sea Premium
SPOTIFY_CLIENT_ID=
